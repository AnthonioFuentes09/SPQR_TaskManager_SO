<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- Paleta: la misma de los mockups aprobados. -->
    <SolidColorBrush x:Key="Ink"     Color="#1B2430"/>
    <SolidColorBrush x:Key="Ink2"    Color="#5A6875"/>
    <SolidColorBrush x:Key="Ink3"    Color="#8896A4"/>
    <SolidColorBrush x:Key="Panel"   Color="#F6F8FA"/>
    <SolidColorBrush x:Key="Panel2"  Color="#EEF2F6"/>
    <SolidColorBrush x:Key="Linea"   Color="#D7DEE6"/>
    <SolidColorBrush x:Key="Linea2"  Color="#E8EDF2"/>
    <SolidColorBrush x:Key="Navy"    Color="#1F3864"/>
    <SolidColorBrush x:Key="Navy2"   Color="#2F5590"/>
    <SolidColorBrush x:Key="Ok"      Color="#2F8F52"/>
    <SolidColorBrush x:Key="OkBg"    Color="#DCF0E3"/>
    <SolidColorBrush x:Key="Warn"    Color="#A07A05"/>
    <SolidColorBrush x:Key="WarnBg"  Color="#FBF0C4"/>
    <SolidColorBrush x:Key="Bad"     Color="#B32B3C"/>
    <SolidColorBrush x:Key="BadBg"   Color="#F8D8DC"/>
    <SolidColorBrush x:Key="Blanco"  Color="#FFFFFF"/>

    <FontFamily x:Key="Mono">Consolas</FontFamily>

    <!-- Encabezado de tarjeta -->
    <Style x:Key="TituloTarjeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="Margin" Value="12,8,12,8"/>
    </Style>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{StaticResource Blanco}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="Pista" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Botones -->
    <Style x:Key="BotonPlano" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Blanco}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonPlano}">
        <Setter Property="Background" Value="{StaticResource Navy}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Navy}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Tablas -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Linea2}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource Blanco}"/>
        <Setter Property="RowBackground" Value="{StaticResource Blanco}"/>
        <Setter Property="AlternatingRowBackground" Value="#FBFCFD"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="26"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style TargetType="{x:Type prim:DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
