<UserControl x:Class="SPQR.UI.Vistas.VistaEmulacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="KpiRotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        </Style>
        <Style x:Key="KpiValor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Leyenda" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,16,0"/>
        </Style>
        <Style x:Key="Muestra" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,0,1"
                Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="Emular MMU" Style="{StaticResource Titulo}"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Reproducción paso a paso. Los paneles están sincronizados por el mismo instante de tiempo."/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,24,20">
            <StackPanel>

                <!-- reproductor -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Linea}"
                        BorderThickness="1" CornerRadius="7" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="⏮" Style="{StaticResource BotonPlano}" Command="{Binding AlPrincipio}" Width="34"/>
                            <Button Content="◀" Style="{StaticResource BotonPlano}" Command="{Binding Retroceder}" Width="34"/>
                            <Button Content="{Binding TextoBotonReproducir}" Style="{StaticResource BotonPrimario}"
                                    Command="{Binding Reproducir}" MinWidth="92"/>
                            <Button Content="▶" Style="{StaticResource BotonPlano}" Command="{Binding Avanzar}" Width="34"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Style="{StaticResource Pista}" MinWidth="86"
                                   Margin="10,0" Text="{Binding PosicionTexto}"/>

                        <Slider Grid.Column="2" VerticalAlignment="Center" Minimum="0"
                                Maximum="{Binding InstanteMaximo}" Value="{Binding Instante, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,0"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Pista}" Text="Velocidad" Margin="0,0,7,0"/>
                            <ComboBox SelectedIndex="1" Width="74" SelectionChanged="Velocidad_Changed">
                                <ComboBoxItem Content="0.5×"/>
                                <ComboBoxItem Content="1×"/>
                                <ComboBoxItem Content="2×"/>
                                <ComboBoxItem Content="4×"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- indicadores -->
                <UniformGrid Columns="6" Margin="0,14,0,0">
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Text="EN CPU"/>
                            <TextBlock Style="{StaticResource KpiValor}" Text="{Binding EnCpu}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Text="PÁGINA REFERENCIADA"/>
                            <TextBlock Style="{StaticResource KpiValor}" FontSize="14" Text="{Binding PaginaRef}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Text="MARCOS EN USO"/>
                            <TextBlock Style="{StaticResource KpiValor}" Text="{Binding MarcosTexto}"/>
                        </StackPanel>
                    </Border>

                    <!-- Acumulados hasta el instante que se está mirando: sirven
                         para ver cómo se forma el número mientras se reproduce. -->
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Text="FALLOS HASTA AQUÍ"/>
                            <TextBlock Style="{StaticResource KpiValor}" FontSize="15" Text="{Binding FallosTexto}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Text="RENDIMIENTO HASTA AQUÍ"/>
                            <TextBlock Style="{StaticResource KpiValor}" Text="{Binding RendimientoTexto}"/>
                        </StackPanel>
                    </Border>

                    <!-- El de la corrida completa, que no cambia al mover el
                         deslizador: este es el que se compara con la tabla. -->
                    <Border Style="{StaticResource Kpi}" Margin="0"
                            BorderBrush="{StaticResource Navy}" BorderThickness="1.6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiRotulo}" Foreground="{StaticResource Navy}"
                                       Text="RENDIMIENTO FINAL = 1 − F"/>
                            <TextBlock Style="{StaticResource KpiValor}" Text="{Binding RendimientoFinalTexto}"/>
                            <TextBlock Style="{StaticResource Pista}" Text="{Binding FallosFinalTexto}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- administrador de tareas -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                                   Text="PROCESOS · VISTA DE ADMINISTRADOR DE TAREAS"/>
                        <DataGrid ItemsSource="{Binding Tareas}" MaxHeight="220">
                            <DataGrid.Columns>
                                <!-- El punto de color es el mismo que identifica al proceso
                                     en el mapa de marcos y en la línea de tiempo. -->
                                <DataGridTemplateColumn Header="PROCESO" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="9,0,0,0">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Color}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Navy}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>

                                <DataGridTemplateColumn Header="ESTADO" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Estado}" Foreground="{Binding TintaEstado}"
                                                       FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" Width="75"/>
                                <DataGridTextColumn Header="MEMORIA (KB)" Binding="{Binding MemoriaKb}" Width="110"/>

                                <DataGridTemplateColumn Header="USO" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Height="6" Width="100" CornerRadius="3" Margin="9,0,0,0"
                                                    Background="{StaticResource Linea2}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border CornerRadius="3" Background="{Binding Color}"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding Uso}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="MARCOS" Binding="{Binding MarcosTexto}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- línea de tiempo -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                                   Text="LÍNEA DE TIEMPO DE PROCESOS"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                            <Border Style="{StaticResource Muestra}" Background="{StaticResource OkBg}"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="E · ejecutando"/>
                            <Border Style="{StaticResource Muestra}" Background="{StaticResource WarnBg}"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="B · en espera"/>
                            <Border Style="{StaticResource Muestra}" Background="{StaticResource BadBg}"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="F · finalizado"/>
                            <Border Style="{StaticResource Muestra}" Background="White"
                                    BorderBrush="{StaticResource Navy}" BorderThickness="2"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="instante actual"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="12,0,12,0">
                            <StackPanel>
                                <!-- cabecera de instantes -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="118" Height="19" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,1"/>
                                    <ItemsControl ItemsSource="{Binding Tiempos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="23" Height="19" Background="{StaticResource Panel}"
                                                        BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}"
                                                               FontSize="8.5" Foreground="{StaticResource Ink3}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- una fila por proceso -->
                                <ItemsControl ItemsSource="{Binding LineaDeTiempo}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="118" Height="21" Background="{StaticResource Panel}"
                                                        BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,1">
                                                    <StackPanel Orientation="Horizontal" Margin="7,0,0,0">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Proceso}" FontSize="10"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource Navy}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Celdas}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="celda" Width="23" Height="21"
                                                                    Background="{Binding Fondo}"
                                                                    BorderBrush="{StaticResource Linea2}"
                                                                    BorderThickness="0,0,1,1">
                                                                <TextBlock Text="{Binding Letra}"
                                                                           Foreground="{Binding Tinta}"
                                                                           FontFamily="{StaticResource Mono}"
                                                                           FontSize="9.5" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                                    <Setter TargetName="celda" Property="BorderBrush"
                                                                            Value="{StaticResource Navy}"/>
                                                                    <Setter TargetName="celda" Property="BorderThickness"
                                                                            Value="2"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ============================================================
                     HISTORIAL DE PAGINACIÓN
                     ============================================================
                     La cuadrícula del pizarrón: una columna por REFERENCIA (no
                     por proceso), una fila por marco físico, y abajo la fila de
                     estado con «x» para el fallo y «//» para el acierto.

                     Es la comprobación a mano del rendimiento: se cuentan las
                     «x», se dividen entre el número de columnas y eso es F.
                -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                                   Text="HISTORIAL DE PAGINACIÓN · UNA COLUMNA POR REFERENCIA"/>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12">
                            <Border Style="{StaticResource Muestra}" Background="{StaticResource BadBg}"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="x · fallo de página"/>
                            <Border Style="{StaticResource Muestra}" Background="{StaticResource OkBg}"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="// · acierto"/>
                            <Border Style="{StaticResource Muestra}" Background="White"
                                    BorderBrush="{StaticResource Bad}" BorderThickness="2"/>
                            <TextBlock Style="{StaticResource Leyenda}" Text="página recién cargada"/>
                            <TextBlock Style="{StaticResource Leyenda}"
                                       Text="cada celda: proceso + página, y abajo su bit R"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="12,0,12,0">
                            <StackPanel>

                                <!-- encabezado: la referencia pedida en cada instante -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="92" Height="26" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,1">
                                        <TextBlock Text="Referencia" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Ink3}"
                                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Referencias}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="encabezado" Width="34" Height="26"
                                                        Background="{Binding FondoEncabezado}"
                                                        BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding Texto}"
                                                               Foreground="{Binding TintaEncabezado}"
                                                               FontFamily="{StaticResource Mono}"
                                                               FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                        <Setter TargetName="encabezado" Property="BorderBrush"
                                                                Value="{StaticResource Navy}"/>
                                                        <Setter TargetName="encabezado" Property="BorderThickness"
                                                                Value="2"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- una fila por marco físico -->
                                <ItemsControl ItemsSource="{Binding HistorialPaginacion}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="92" Height="30" Background="{StaticResource Panel}"
                                                        BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding Etiqueta}" FontSize="10"
                                                               FontWeight="SemiBold" Foreground="{StaticResource Navy}"
                                                               VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Celdas}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Width="34" Height="30">
                                                                <Border Background="{Binding Fondo}"
                                                                        BorderBrush="{Binding Borde}"
                                                                        BorderThickness="{Binding GrosorBorde}">
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Texto}"
                                                                                   Foreground="{Binding Tinta}"
                                                                                   FontFamily="{StaticResource Mono}"
                                                                                   FontSize="10" FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding BitTexto}"
                                                                                   Foreground="{StaticResource Ink3}"
                                                                                   FontFamily="{StaticResource Mono}"
                                                                                   FontSize="8"
                                                                                   HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <!-- el recuadro del instante actual va encima,
                                                                     para no pisar el borde rojo de la carga -->
                                                                <Border x:Name="foco" BorderThickness="0"
                                                                        BorderBrush="{StaticResource Navy}"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                                    <Setter TargetName="foco" Property="BorderThickness"
                                                                            Value="2"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- pie: x = fallo, // = acierto -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="92" Height="26" Background="{StaticResource Panel}"
                                            BorderBrush="{StaticResource Linea}" BorderThickness="0,1,1,0">
                                        <TextBlock Text="Estado" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Ink3}"
                                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Marcas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="marca" Width="34" Height="26"
                                                        Background="{Binding Fondo}"
                                                        BorderBrush="{StaticResource Linea2}" BorderThickness="0,1,1,0">
                                                    <TextBlock Text="{Binding Texto}"
                                                               Foreground="{Binding Tinta}"
                                                               FontFamily="{StaticResource Mono}"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                        <Setter TargetName="marca" Property="BorderBrush"
                                                                Value="{StaticResource Navy}"/>
                                                        <Setter TargetName="marca" Property="BorderThickness"
                                                                Value="2"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- mapa de marcos -->
                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TituloTarjeta}" Text="MAPA DE MARCOS · MEMORIA FÍSICA"/>
                            <ItemsControl ItemsSource="{Binding Marcos}" Margin="12,0,12,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- El color lo pone el proceso dueño: el mismo que
                                             lleva en la lista de tareas y en la línea de
                                             tiempo. Rojo = víctima del reemplazo. -->
                                        <Border Margin="3" Padding="7,8" CornerRadius="5"
                                                Background="{Binding Fondo}"
                                                BorderBrush="{Binding Borde}" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Etiqueta}" FontSize="9.5"
                                                           FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Ink3}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Contenido}" FontSize="12.5" FontWeight="Bold"
                                                           FontFamily="{StaticResource Mono}"
                                                           Foreground="{Binding Tinta}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Bits}" FontSize="9"
                                                           FontFamily="{StaticResource Mono}"
                                                           Foreground="{StaticResource Ink3}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Pista}" Margin="12,0,12,12" TextWrapping="Wrap"
                                       Text="Color por proceso dueño · rojo = víctima del reemplazo · R = referenciada · M = modificada"/>
                        </StackPanel>
                    </Border>

                    <!-- tabla de páginas -->
                    <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}" Text="TABLA DE PAGINACIÓN"/>
                            <ComboBox DockPanel.Dock="Top" Margin="12,0,12,10"
                                      ItemsSource="{Binding Procesos}" DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding ProcesoObservado, Mode=TwoWay}"/>
                            <DataGrid ItemsSource="{Binding TablaDePaginas}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PÁGINA" Binding="{Binding Pagina}" Width="65"/>
                                    <DataGridTemplateColumn Header="PRESENTE" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PresenteTexto}" Margin="9,0,0,0"
                                                           Foreground="{Binding TintaPresente}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="MARCO" Binding="{Binding Marco}" Width="65"/>
                                    <DataGridTextColumn Header="BIT R" Binding="{Binding BitR}" Width="50"/>
                                    <DataGridTextColumn Header="BIT M" Binding="{Binding BitM}" Width="50"/>
                                    <DataGridTextColumn Header="CLASE" Binding="{Binding Clase}" Width="55"/>
                                    <DataGridTextColumn Header="ÚLTIMO USO" Binding="{Binding UltimoUso}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- log -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                                   Text="LOG DE EVENTOS · HISTORIAL COMPLETO DE LA CORRIDA"/>
                        <DataGrid ItemsSource="{Binding Log}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="T" Binding="{Binding Instante}" Width="50"/>
                                <DataGridTextColumn Header="PROCESO" Binding="{Binding Proceso}" Width="160"/>
                                <DataGridTextColumn Header="DETALLE" Binding="{Binding Detalle}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
