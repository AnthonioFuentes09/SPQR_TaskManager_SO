<UserControl x:Class="SPQR.UI.Vistas.VistaProgramas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,0,1"
                Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="Configuración de programas" Style="{StaticResource Titulo}"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Catálogo de programas con todos los registros que usan los algoritmos. Se define una vez; después se instancian en la lista de ejecución."/>
            </StackPanel>
        </Border>

        <!-- El trabajo se guarda en un archivo .db de SQLite: el escenario y el
             historial de corridas. Mismo criterio que el proyecto anterior, un
             archivo es un banco de trabajo completo y autocontenido. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,0,1" Padding="24,9">
            <StackPanel Orientation="Horizontal">
                <Button Content="Abrir escenario…" Style="{StaticResource BotonPlano}" Click="Abrir_Click"/>
                <Button Content="Guardar" Style="{StaticResource BotonPlano}" Click="Guardar_Click"/>
                <Button Content="Guardar como…" Style="{StaticResource BotonPlano}" Click="GuardarComo_Click"/>
                <Button Content="Escenario de ejemplo" Style="{StaticResource BotonPlano}" Click="Ejemplo_Click"/>
                <Border Width="1" Background="{StaticResource Linea}" Margin="4,2,11,2"/>
                <Button Content="Exportar JSON…" Style="{StaticResource BotonPlano}" Click="ExportarJson_Click"/>
                <Button Content="Importar JSON…" Style="{StaticResource BotonPlano}" Click="ImportarJson_Click"/>
                <TextBlock Style="{StaticResource Pista}" Margin="10,0,0,0"
                           Text="{Binding TituloDelEscenario}"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,14,24,10">
            <Button Content="+ Agregar programa" Style="{StaticResource BotonPrimario}" Click="Agregar_Click"/>
            <Button Content="Duplicar" Style="{StaticResource BotonPlano}" Click="Duplicar_Click"/>
            <Button Content="Quitar" Style="{StaticResource BotonPlano}" Click="Quitar_Click"/>
            <TextBlock Style="{StaticResource Pista}" Margin="12,0,0,0"
                       Text="Cadena de referencias: «0, 1, 2w, 1, 3» — la w marca escritura."/>
        </StackPanel>

        <Border Style="{StaticResource Tarjeta}" Margin="24,0,24,20">
            <DataGrid x:Name="Tabla" ItemsSource="{Binding Programas}" IsReadOnly="False"
                      SelectedItem="{Binding ProgramaSeleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="60"/>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="150"/>
                    <DataGridTextColumn Header="PÁGINAS" Binding="{Binding TamanioEnPaginas, UpdateSourceTrigger=LostFocus}" Width="80"/>
                    <DataGridTextColumn Header="CADENA DE REFERENCIAS" Binding="{Binding CadenaTexto, UpdateSourceTrigger=LostFocus}" Width="*"/>
                    <DataGridTextColumn Header="PRIORIDAD" Binding="{Binding Prioridad, UpdateSourceTrigger=LostFocus}" Width="90"/>
                    <DataGridTextColumn Header="BOLETOS" Binding="{Binding Boletos, UpdateSourceTrigger=LostFocus}" Width="80"/>
                    <DataGridTextColumn Header="% ASIGNACIÓN" Binding="{Binding PorcentajeAsignacion, UpdateSourceTrigger=LostFocus}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
