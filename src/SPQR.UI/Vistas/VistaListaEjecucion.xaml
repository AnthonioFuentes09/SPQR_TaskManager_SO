<UserControl x:Class="SPQR.UI.Vistas.VistaListaEjecucion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Linea2}" BorderThickness="0,0,0,1"
                Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="Definición de lista de ejecución" Style="{StaticResource Titulo}"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="La secuencia predeterminada de procesos. Un mismo programa puede aparecer varias veces, cada instancia con su propia ráfaga."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="24,10,24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Pista}"
                           Text="{Binding SumaDeRafagas, StringFormat='Suma de ráfagas: {0} · la simulación llega hasta ese instante'}"/>
                <Button Content="Simular →" Style="{StaticResource BotonPrimario}"
                        Command="{Binding Simular}" Margin="16,0,0,0" Padding="16,6"/>
            </StackPanel>
        </Border>

        <Grid Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                               Text="LISTA DE EJECUCIÓN"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,10">
                        <Button Content="+ Instanciar programa…" Style="{StaticResource BotonPlano}" Click="Instanciar_Click"/>
                        <Button Content="Duplicar" Style="{StaticResource BotonPlano}" Click="Duplicar_Click"/>
                        <Button Content="Quitar" Style="{StaticResource BotonPlano}" Click="Quitar_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="Tabla" ItemsSource="{Binding Procesos}" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" IsReadOnly="True" Width="40"/>

                            <!-- El programa se puede cambiar después de creada la fila: sin
                                 esto, una instancia con el programa equivocado había que
                                 borrarla y volver a crearla. -->
                            <DataGridComboBoxColumn Header="PROGRAMA" Width="*"
                                                    DisplayMemberPath="Nombre"
                                                    SelectedItemBinding="{Binding Programa, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Programas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.Programas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>

                            <DataGridTextColumn Header="RÁFAGA" Binding="{Binding Rafaga, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            <DataGridTextColumn Header="LLEGADA" Binding="{Binding TiempoLlegada, UpdateSourceTrigger=LostFocus}" Width="80"/>

                            <!-- La cola se elige de las que existen. Antes era un entero
                                 libre: escribir 7 mandaba el proceso a una regla FIFO
                                 invisible que no aparecía en ninguna pantalla. -->
                            <DataGridComboBoxColumn Header="COLA" Width="75"
                                                    SelectedValueBinding="{Binding Cola, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.NumerosDeCola, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource"
                                                Value="{Binding DataContext.NumerosDeCola, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TituloTarjeta}" Text="ALGORITMO DE PLANIFICACIÓN"/>
                        <StackPanel Margin="12,0,12,12">
                            <ComboBox ItemsSource="{Binding AlgoritmosPlanificacion}"
                                      SelectedItem="{Binding Config.AlgoritmoPlanificacion, Mode=TwoWay}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quantum global" FontSize="12" Foreground="{StaticResource Ink2}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Config.Quantum, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Pista}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Desempate: llegada, luego identificador."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloTarjeta}"
                                   Text="REGLAS POR COLA · SOLO PARA MÚLTIPLES COLAS"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,10">
                            <Button Content="+ Cola" Style="{StaticResource BotonPlano}" Click="AgregarCola_Click"/>
                            <Button Content="Quitar cola" Style="{StaticResource BotonPlano}" Click="QuitarCola_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="TablaColas" ItemsSource="{Binding Colas}" IsReadOnly="False" MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="COLA" Binding="{Binding Numero, UpdateSourceTrigger=LostFocus}" Width="55"/>
                                <DataGridTextColumn Header="ETIQUETA" Binding="{Binding Etiqueta, UpdateSourceTrigger=LostFocus}" Width="85"/>
                                <DataGridComboBoxColumn Header="ALGORITMO INTERNO"
                                                        SelectedValueBinding="{Binding Algoritmo}" Width="*">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.AlgoritmosDeCola, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.AlgoritmosDeCola, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="QUANTUM" Binding="{Binding Quantum, UpdateSourceTrigger=LostFocus}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
