<Window x:Class="SPQR.UI.Vistas.DialogoInstanciar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instanciar un programa"
        Height="360" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="18,13">
            <StackPanel>
                <TextBlock Text="Instanciar un programa" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Foreground="#C3D0E4" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Cada instancia es un proceso distinto, con su propia ráfaga y su propio tiempo de llegada."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Linea}" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource BotonPlano}" IsCancel="True" MinWidth="86"/>
                <Button Content="Agregar" Style="{StaticResource BotonPrimario}" IsDefault="True"
                        MinWidth="86" Margin="0" Click="Agregar_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="18,16,18,0">
            <TextBlock Text="PROGRAMA" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CampoPrograma" DisplayMemberPath="Nombre" Height="28"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RÁFAGA" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CampoRafaga" Text="6" Height="26"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TIEMPO DE LLEGADA" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CampoLlegada" Text="0" Height="26"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="COLA" Style="{StaticResource TituloTarjeta}" Margin="0,14,0,4"/>
            <ComboBox x:Name="CampoCola" DisplayMemberPath="Descripcion" Height="28"/>

            <TextBlock x:Name="Aviso" Foreground="{StaticResource Bad}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

            <TextBlock Style="{StaticResource Pista}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="La cola solo la usa el algoritmo de múltiples colas; los otros seis la ignoran."/>
        </StackPanel>
    </DockPanel>
</Window>
